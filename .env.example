# Frontend env contract.
#
# Every VITE_* var is inlined by Vite into the client bundle as a string
# literal at build time and shipped to every visitor — they are PUBLIC
# by design. Never put anything secret behind a VITE_ prefix; route it
# through the Django API instead.
#
# On Netlify, every VITE_* var must be marked is_secret=FALSE with the
# scope "builds,functions,post_processing,runtime". The is_secret flag
# strips the post_processing scope and causes Netlify to substitute the
# masked value into the bundle, silently breaking prod. vite.config.ts
# asserts this at build time and src/env.ts asserts it at app boot.

# ── Required ────────────────────────────────────────────────────────

# Google Maps JavaScript API key. Protected by HTTP-referrer + API
# restrictions in GCP — the key itself in JS is fine.
VITE_GOOGLE_MAPS_API_KEY=

# Google Maps Map ID. Required for AdvancedMarkerElement (needs a
# Vector map). Create at https://console.cloud.google.com/google/maps-apis/studio/maps
VITE_GOOGLE_MAP_ID=

# Cloudflare Turnstile site key — pairs with TURNSTILE_SECRET_KEY in
# the Django env. Required so the prod build can't silently ship a
# bundle without the captcha widget (which would 400 every signup).
# Cloudflare's always-pass test key for local dev: 1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY=

# ── Optional ────────────────────────────────────────────────────────

# Google OAuth client ID — enables "Continue with Google" on /login &
# /register. When empty, the Google button is hidden and email/password
# still works. Authorized JavaScript origins must include the prod
# origin and http://localhost:8080.
VITE_GOOGLE_CLIENT_ID=

# Sentry DSN — enables JS error reporting from the SPA. DSNs are
# designed to be public (they only allow event ingestion for the
# project they're scoped to). Leave empty to skip Sentry init.
VITE_SENTRY_DSN=

# Django API base URL. When empty, the apiClient emits relative
# /api/... paths (which Netlify's [[redirects]] block proxies in prod
# and the Vite dev server proxies locally). Override only when pointing
# at a non-default backend.
VITE_API_BASE_URL=
