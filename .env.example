# Google Maps API Key (required for satellite maps)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Google Maps Map ID (required — AdvancedMarkerElement needs a vector map).
# Create one at https://console.cloud.google.com/google/maps-apis/studio/maps
# (Map type: JavaScript, Map style: Vector). Non-secret; lands in the browser.
VITE_GOOGLE_MAP_ID=your_map_id_here

# Google OAuth client ID (optional — enables "Continue with Google" on /login & /register)
# Get one at https://console.cloud.google.com/apis/credentials. Must include
# http://localhost:8080 (or your prod origin) under "Authorized JavaScript origins".
# When empty, the Google button is hidden and email/password still works.
VITE_GOOGLE_CLIENT_ID=

# Django API base URL (required for authentication)
VITE_API_BASE_URL=http://localhost:8000
